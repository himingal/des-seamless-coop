<Window x:Class="DesCoop.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeS Seamless Co-op · Setup" Width="620" Height="430" ResizeMode="NoResize"
        Background="{StaticResource Backdrop}" WindowStartupLocation="CenterScreen" Icon="app.ico" FontFamily="Segoe UI" Topmost="True">
    <Grid Margin="36,26,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="DEMON'S SOULS" FontFamily="{StaticResource Serif}" FontSize="32" Foreground="#E6DCC6" HorizontalAlignment="Center">
                <TextBlock.Effect><DropShadowEffect Color="#C4A468" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
            </TextBlock>
            <Border Height="1" Background="{StaticResource Rule}" Width="380" Margin="0,4,0,6"/>
            <TextBlock x:Name="TxtTitle" Text="PREPARING THE NEXUS" FontFamily="{StaticResource Serif}" FontSize="13" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"/>
        </StackPanel>

        <ItemsControl x:Name="Steps" Grid.Row="1" Margin="40,22,40,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4">
                        <Rectangle Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,12,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="{Binding State}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Serif}" FontSize="13"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="TxtStatus" Style="{StaticResource Small}" TextAlignment="Center" Text="Starting…"/>
            <ProgressBar x:Name="Bar" Margin="0,8,0,0" Maximum="1"/>
            <Button x:Name="BtnClose" Content="Continue" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
