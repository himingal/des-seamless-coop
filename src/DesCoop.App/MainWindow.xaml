<Window x:Class="DesCoop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeS Seamless Co-op" Width="1080" Height="760" MinWidth="900" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="app.ico" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <Image Source="app.ico" Width="46" Height="46" Margin="0,0,14,0" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DEMON'S SOULS" FontSize="26" FontFamily="Georgia" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/>
                <TextBlock Text="Seamless Co-op para RPCS3  ·  entre na party do seu amigo e joguem juntos o tempo que quiserem" Style="{StaticResource Small}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Setup -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1 · Preparação" Style="{StaticResource H}"/>

                        <!-- RPCS3 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="DotRpcs3" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource Bad}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Emulador RPCS3" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRpcs3" Style="{StaticResource Small}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnRpcs3Install" Content="Baixar" Click="BtnRpcs3Install_Click" Margin="6,0,0,0"/>
                                <Button x:Name="BtnRpcs3Pick" Content="Já tenho…" Click="BtnRpcs3Pick_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Firmware -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="DotFw" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource Bad}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Firmware do PS3" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtFw" Style="{StaticResource Small}"/>
                            </StackPanel>
                            <Button x:Name="BtnFw" Grid.Column="2" Content="Instalar" Click="BtnFw_Click" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Game -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="DotGame" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource Bad}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Demon's Souls (seu dump)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtGame" Style="{StaticResource Small}"/>
                            </StackPanel>
                            <Button x:Name="BtnGame" Grid.Column="2" Content="Escolher pasta…" Click="BtnGame_Click" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Patch -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="DotPatch" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource Warn}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Patch co-op no jogo" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkBlue" Content="Blue Eye Stone funciona em forma humana" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                <TextBlock Text="depois do boss o amigo já coloca o sinal de novo, sem precisar morrer" Style="{StaticResource Small}" Margin="20,-2,0,4"/>
                                <CheckBox x:Name="ChkEph" Content="Stone of Ephemeral Eyes infinita" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                <TextBlock Text="o host sempre consegue voltar ao corpo para invocar" Style="{StaticResource Small}" Margin="20,-2,0,4"/>
                                <TextBlock x:Name="TxtPatch" Style="{StaticResource Small}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Button x:Name="BtnPatch" Content="Aplicar" Click="BtnPatch_Click"/>
                                <Button x:Name="BtnUnpatch" Content="Original" Click="BtnUnpatch_Click" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- RPCN -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="DotRpcn" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource Bad}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Conta RPCN (a &quot;PSN&quot; do RPCS3)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRpcn" Style="{StaticResource Small}"/>
                            </StackPanel>
                            <Button x:Name="BtnRpcn" Grid.Column="2" Content="Criar / entrar" Click="BtnRpcn_Click" VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Party -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="2 · Party" Style="{StaticResource H}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbHost" Content="Criar party (host)" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbJoin" Content="Entrar na party" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbPublic" Content="Servidor público" GroupName="mode" Checked="Mode_Changed"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <!-- Host -->
                        <StackPanel x:Name="PanelHost" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Nome" VerticalAlignment="Center" Width="46"/>
                                <Button x:Name="BtnHost" Content="Criar party" DockPanel.Dock="Right" Click="BtnHost_Click" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtPartyName"/>
                            </DockPanel>
                            <CheckBox x:Name="ChkUpnp" Content="Abrir portas no roteador automaticamente (UPnP)"/>
                            <Border x:Name="CodeBox" Visibility="Collapsed" Background="#0F0E0B" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Mande este código para o seu amigo:" Style="{StaticResource Small}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <Button x:Name="BtnCopy" Content="Copiar" DockPanel.Dock="Right" Click="BtnCopy_Click" Margin="8,0,0,0"/>
                                        <TextBox x:Name="TxtCode" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtHostInfo" Style="{StaticResource Small}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Join -->
                        <StackPanel x:Name="PanelJoin" Visibility="Collapsed">
                            <TextBlock Text="Cole o código que o host te mandou (ou o IP dele):" Style="{StaticResource Small}" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button x:Name="BtnJoin" Content="Entrar" DockPanel.Dock="Right" Click="BtnJoin_Click" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtJoinCode" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="60"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtJoinInfo" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Public -->
                        <StackPanel x:Name="PanelPublic" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Small}" Text="Usa o servidor da comunidade The Archstones: mensagens, fantasmas e sinais de jogadores do mundo todo. Co-op normal do jogo (sem os sinais de party que seguem o host)."/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock Text="Na party agora" DockPanel.Dock="Top" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border DockPanel.Dock="Top" Background="#0F0E0B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" MinHeight="70" Padding="8">
                            <ItemsControl x:Name="ListPlayers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="{Binding Badge}" DockPanel.Dock="Right" Foreground="{StaticResource Gold}" FontSize="12"/>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="  ·  " Foreground="{StaticResource Muted}"/>
                                                <Run Text="{Binding Area, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock x:Name="TxtNoPlayers" DockPanel.Dock="Top" Style="{StaticResource Small}" Margin="0,4,0,0"
                                   Text="Ninguém conectado ainda. Os jogadores aparecem aqui quando o jogo entra online."/>
                        <TextBlock Text="Como jogar juntos" DockPanel.Dock="Top" Foreground="{StaticResource Gold}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Small}" LineHeight="18">
                            <Run Text="1. Os dois clicam JOGAR (o online liga sozinho)."/><LineBreak/>
                            <Run Text="2. Quem vai ajudar usa a Blue Eye Stone em qualquer lugar do mundo."/><LineBreak/>
                            <Run Text="3. O sinal aparece do lado do host em segundos, onde ele estiver. Host toca no sinal, pronto."/><LineBreak/>
                            <Run Text="4. Depois do boss: Blue Eye Stone de novo e seguem juntos."/>
                        </TextBlock>
                        <TextBox x:Name="TxtLog" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="60"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
            <DockPanel>
                <Button x:Name="BtnPlay" Content="JOGAR" DockPanel.Dock="Right" Style="{StaticResource PlayBtn}" Click="BtnPlay_Click"/>
                <CheckBox x:Name="ChkFullscreen" Content="Tela cheia" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtStatus" Text="Pronto." FontSize="13"/>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0" Background="#221F17" Foreground="{StaticResource Gold}" BorderThickness="0" Visibility="Hidden" Maximum="1"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
