<Window x:Class="DesCoop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeS Seamless Co-op" Width="1140" Height="800" MinWidth="960" MinHeight="700"
        Background="{StaticResource Backdrop}" WindowStartupLocation="CenterScreen"
        Icon="app.ico" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Margin="0,0,0,18">
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" Padding="12,6" BorderThickness="1"
                BorderBrush="{StaticResource Line}" Background="#80050506" ToolTip="Is Demon's Souls running in RPCS3?">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DotGameTop" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtGameTop" Text="GAME CLOSED" FontFamily="{StaticResource Serif}" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </Border>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="DEMON'S SOULS" FontFamily="{StaticResource Serif}" FontSize="44" Foreground="#E6DCC6" HorizontalAlignment="Center">
                <TextBlock.Effect><DropShadowEffect Color="#C4A468" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
            </TextBlock>
            <Grid Width="520" Margin="0,4,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="SEAMLESS  CO-OP" FontFamily="{StaticResource Serif}" FontSize="14" Foreground="{StaticResource Gold}" Margin="16,0"/>
                <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Join your friend's world on RPCS3 and stay together for as long as you want." Style="{StaticResource Small}" HorizontalAlignment="Center"/>
        </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- The Nexus: setup -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="THE NEXUS" Style="{StaticResource H}" Margin="14,0"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotRpcs3" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="RPCS3 Emulator" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtRpcs3" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="BtnRpcs3Install" Content="Download" Click="BtnRpcs3Install_Click"/>
                                    <Button x:Name="BtnRpcs3Pick" Content="Browse" Click="BtnRpcs3Pick_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotFw" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PS3 Firmware" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtFw" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <Button x:Name="BtnFw" Grid.Column="2" Content="Install" Click="BtnFw_Click" VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotGame" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Demon's Souls" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtGame" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <Button x:Name="BtnGame" Grid.Column="2" Content="Browse" Click="BtnGame_Click" VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotPatch" Style="{StaticResource Dot}" Fill="{StaticResource Warn}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Game Tweaks" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkBlue" Content="Blue Eye Stone works in body form" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="after a boss, your friend places the sign again without dying" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <CheckBox x:Name="ChkEph" Content="Endless Stone of Ephemeral Eyes" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="the host can always return to body form to summon" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <CheckBox x:Name="ChkSoul" Content="Soul form keeps full HP" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="dying no longer halves your HP: soul form plays like body form" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <CheckBox x:Name="ChkStaySoul" Content="Stay in soul form" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="no automatic revival after bosses, so the Blue Eye Stone is always ready (Ephemeral Eyes still revives)" Style="{StaticResource Small}" Margin="21,-1,0,4" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="ChkStartBlue" Content="Start with both co-op stones" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="every new character carries a Blue Eye Stone and a Stone of Ephemeral Eyes" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <CheckBox x:Name="ChkClasses" Content="10 new starting classes" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock x:Name="TxtClasses" Style="{StaticResource Small}" Margin="21,-1,0,4" Cursor="Help"
                                               Text="new names, stats and gear, every weapon usable from the start (hover to see them)"/>
                                    <CheckBox x:Name="ChkShops" Content="Merchants sell everything at half price" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <CheckBox x:Name="ChkBlade" Content="Pure Bladestone: 15% drop from Shrine skeletons" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="instead of 0.5%" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <CheckBox x:Name="ChkLoad" Content="+50% equip load and item burden" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="weapons, armor, rings and items weigh a third less" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <CheckBox x:Name="ChkMats" Content="Upgrade stones drop far more often" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <CheckBox x:Name="ChkLizard" Content="Crystal Lizards die in one hit" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <CheckBox x:Name="ChkDragon" Content="Red and Blue dragons: half HP" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <CheckBox x:Name="ChkSouls" Content="+25% souls from enemies" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <CheckBox x:Name="ChkMana" Content="Passive MP regeneration" Checked="PatchOption_Changed" Unchecked="PatchOption_Changed"/>
                                    <TextBlock Text="about 1 MP per second while any chest armor is worn" Style="{StaticResource Small}" Margin="21,-1,0,4"/>
                                    <TextBlock x:Name="TxtPatch" Style="{StaticResource Small}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Button x:Name="BtnPatch" Content="Apply" Click="BtnPatch_Click"/>
                                    <Button x:Name="BtnUnpatch" Content="Restore" Click="BtnUnpatch_Click" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotRpcn" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="RPCN Account" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtRpcn" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <Button x:Name="BtnRpcn" Grid.Column="2" Content="Create / Sign in" Click="BtnRpcn_Click" VerticalAlignment="Top"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Party -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="YOUR PARTY" Style="{StaticResource H}" Margin="14,0"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <RadioButton x:Name="RbHost" Content="HOST A PARTY" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbJoin" Content="JOIN A PARTY" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbPublic" Content="PUBLIC SERVER" GroupName="mode" Checked="Mode_Changed"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top">
                        <StackPanel x:Name="PanelNone">
                            <TextBlock Style="{StaticResource Small}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="One of you hosts, the other joins with the host's code."/>
                        </StackPanel>

                        <StackPanel x:Name="PanelHost" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Party name" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtPartyName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtPartyPass" FontFamily="Consolas"/>
                                </StackPanel>
                                <Button x:Name="BtnHost" Grid.Column="3" Content="Create Party" Click="BtnHost_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                            </Grid>
                            <CheckBox x:Name="ChkUpnp" Content="Also try to open router ports (UPnP)"/>
                            <DockPanel Margin="0,8,0,0">
                                <DockPanel.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="GroupName" Value="wt"/>
                                    </Style>
                                </DockPanel.Resources>
                                <TextBlock Text="World tendency" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           ToolTip="The party server pushes every world toward this tendency (applies when the game syncs with the server)."/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbWtPureWhite" Content="PURE WHITE" Tag="200" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtWhite" Content="WHITE" Tag="100" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtNormal" Content="NORMAL" Tag="0" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtBlack" Content="BLACK" Tag="-100" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtPureBlack" Content="PURE BLACK" Tag="-200" Checked="Tendency_Changed"/>
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="CodeBox" Visibility="Collapsed" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Background="#80050506" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Tell your friend:" Style="{StaticResource Small}"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button x:Name="BtnCopy" Content="Copy" DockPanel.Dock="Right" Click="BtnCopy_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtInvite" FontFamily="{StaticResource Serif}" FontSize="16" Foreground="{StaticResource Soul}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtHostInfo" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelJoin" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Host's party name" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtJoinName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtJoinPass" FontFamily="Consolas"/>
                                </StackPanel>
                                <Button x:Name="BtnJoin" Grid.Column="3" Content="Join" Click="BtnJoin_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock x:Name="TxtJoinInfo" Style="{StaticResource Small}" Margin="0,8,0,0"
                                       Text="No VPN or port forwarding needed: the app finds the host and connects by itself."/>
                        </StackPanel>

                        <StackPanel x:Name="PanelPublic" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Small}" TextAlignment="Center"
                                       Text="Play on The Archstones community server: messages, ghosts and summon signs from players all over the world. Regular co-op, without party signs that follow the host."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="PHANTOMS IN THIS WORLD" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,16,0,6"/>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#80050506" MinHeight="64" Padding="10,6">
                        <Grid>
                            <ItemsControl x:Name="ListPlayers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding Badge}" DockPanel.Dock="Right" Foreground="{StaticResource Soul}" FontSize="12"/>
                                            <Rectangle Width="6" Height="6" Fill="{StaticResource Soul}" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                                            </Rectangle>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource Serif}"/>
                                                <Run Text="   " />
                                                <Run Text="{Binding Area, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtNoPlayers" Style="{StaticResource Small}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Text="No one yet. Players show up here once the game goes online."/>
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="HOW TO PLAY TOGETHER" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,14,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Small}" LineHeight="19">
                        <Run Text="I.   Both press PLAY. Online turns on by itself."/><LineBreak/>
                        <Run Text="II.  The helper uses the Blue Eye Stone anywhere in the world."/><LineBreak/>
                        <Run Text="III. The sign appears right next to the host, wherever they are. Touch it."/><LineBreak/>
                        <Run Text="IV.  Boss down? Blue Eye Stone again and keep going."/>
                    </TextBlock>

                    <TextBox x:Name="TxtLog" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="50"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse x:Name="DotGame2" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtGame2" Text="Demon's Souls is closed" FontFamily="{StaticResource Serif}" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Text="Ready." FontSize="12.5" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="Progress" Margin="0,6,0,0" Visibility="Hidden" Maximum="1"/>
            </StackPanel>
            <Button x:Name="BtnPlay" Grid.Column="1" Content="PLAY" Style="{StaticResource PlayBtn}" Click="BtnPlay_Click"/>
            <CheckBox x:Name="ChkFullscreen" Grid.Column="2" Content="Fullscreen" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
