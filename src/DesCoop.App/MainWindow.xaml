<Window x:Class="DesCoop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeS Seamless Co-op" Width="1140" Height="800" MinWidth="960" MinHeight="700"
        Background="{StaticResource Backdrop}" WindowStartupLocation="CenterScreen"
        Icon="app.ico" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,18,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Margin="0,0,0,18">
        <ComboBox x:Name="CmbLang" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" Width="150"
                  SelectionChanged="CmbLang_Changed" SelectedValuePath="Code">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12"/></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock x:Name="TxtVersion" HorizontalAlignment="Right" Margin="0,0,2,3" FontSize="11"
                       Foreground="{StaticResource Muted}" Opacity="0.75" Text="v0.0.0"/>
            <Border Padding="12,6" BorderThickness="1"
                    BorderBrush="{StaticResource Line}" Background="#80050506" ToolTip="Is Demon's Souls running in RPCS3?">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DotGameTop" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtGameTop" Text="GAME CLOSED" FontFamily="{StaticResource Serif}" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="DEMON'S SOULS" FontFamily="{StaticResource Serif}" FontSize="44" Foreground="#E6DCC6" HorizontalAlignment="Center">
                <TextBlock.Effect><DropShadowEffect Color="#C4A468" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
            </TextBlock>
            <Grid Width="520" Margin="0,4,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="SEAMLESS  CO-OP" FontFamily="{StaticResource Serif}" FontSize="14" Foreground="{StaticResource Gold}" Margin="16,0"/>
                <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="TxtSubtitle" Text="Join your friend's world on RPCS3 and stay together for as long as you want." Style="{StaticResource Small}" HorizontalAlignment="Center"/>
        </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- The Nexus: setup -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblNexus" Grid.Column="1" Text="THE NEXUS" Style="{StaticResource H}" Margin="14,0"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotRpcs3" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LblRpcs3Emu" Text="RPCS3 Emulator" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtRpcs3" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="BtnRpcs3Install" Content="Download" Click="BtnRpcs3Install_Click"/>
                                    <Button x:Name="BtnRpcs3Pick" Content="Browse" Click="BtnRpcs3Pick_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotFw" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LblFwTitle" Text="PS3 Firmware" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtFw" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <Button x:Name="BtnFw" Grid.Column="2" Content="Install" Click="BtnFw_Click" VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotGame" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Demon's Souls" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtGame" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <Button x:Name="BtnGame" Grid.Column="2" Content="Browse" Click="BtnGame_Click" VerticalAlignment="Top"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="DotRpcn" Style="{StaticResource Dot}" Fill="{StaticResource Bad}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="LblRpcn" Text="RPCN Account" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="TxtRpcn" Style="{StaticResource Small}"/>
                                </StackPanel>
                                <Button x:Name="BtnRpcn" Grid.Column="2" Content="Create / Sign in" Click="BtnRpcn_Click" VerticalAlignment="Top"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Rule}" Margin="0,18,0,10"/>
                            <TextBlock x:Name="LblTools" Text="RPCS3 TOOLS" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button x:Name="BtnOpenRpcs3" Content="Open RPCS3" Click="BtnOpenRpcs3_Click" Margin="0,0,8,8"/>
                                <Button x:Name="BtnController" Content="Controller Setup" Click="BtnController_Click" Margin="0,0,8,8"
                                        ToolTip="Opens RPCS3 — go to Config &gt; Gamepads to set up your controller."/>
                                <Button x:Name="Btn60Fps" Content="60 FPS: Off" Click="Btn60Fps_Click" Margin="0,0,0,8"
                                        ToolTip="Applies the community 60 FPS patch to Demon's Souls (physics-safe timestep). Takes effect on PLAY."/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Party -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblYourParty" Grid.Column="1" Text="YOUR PARTY" Style="{StaticResource H}" Margin="14,0"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <RadioButton x:Name="RbHost" Content="HOST A PARTY" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbJoin" Content="JOIN A PARTY" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbPublic" Content="PUBLIC SERVER" GroupName="mode" Checked="Mode_Changed"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top">
                        <StackPanel x:Name="PanelNone"><TextBlock x:Name="TxtNoneHint" Style="{StaticResource Small}" HorizontalAlignment="Center" TextAlignment="Center" Text="One of you hosts, the other joins with the host's code."/>
                        </StackPanel>

                        <StackPanel x:Name="PanelHost" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="LblPartyName" Text="Party name" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtPartyName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblPartyPass" Text="Password" Style="{StaticResource Small}" Margin="0,0,0,3"/><TextBox x:Name="TxtPartyPass" FontFamily="Consolas"/>
                                </StackPanel>
                                <Button x:Name="BtnHost" Grid.Column="3" Content="Create Party" Click="BtnHost_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                            </Grid>
                            <CheckBox x:Name="ChkUpnp" Content="Also try to open router ports (UPnP)"/>
                            <DockPanel Margin="0,8,0,0">
                                <DockPanel.Resources>
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="GroupName" Value="wt"/>
                                    </Style>
                                </DockPanel.Resources>
                                <TextBlock x:Name="LblWorldTendency" Text="World tendency" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           ToolTip="The party server pushes every world toward this tendency (applies when the game syncs with the server)."/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RbWtPureWhite" Content="PURE WHITE" Tag="200" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtWhite" Content="WHITE" Tag="100" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtNormal" Content="NORMAL" Tag="0" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtBlack" Content="BLACK" Tag="-100" Checked="Tendency_Changed"/>
                                    <RadioButton x:Name="RbWtPureBlack" Content="PURE BLACK" Tag="-200" Checked="Tendency_Changed"/>
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="CodeBox" Visibility="Collapsed" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Background="#80050506" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblTellFriend" Text="Tell your friend:" Style="{StaticResource Small}"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button x:Name="BtnCopy" Content="Copy" DockPanel.Dock="Right" Click="BtnCopy_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtInvite" FontFamily="{StaticResource Serif}" FontSize="16" Foreground="{StaticResource Soul}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtHostInfo" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelJoin" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="LblJoinName" Text="Host's party name" Style="{StaticResource Small}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtJoinName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblJoinPass" Text="Password" Style="{StaticResource Small}" Margin="0,0,0,3"/><TextBox x:Name="TxtJoinPass" FontFamily="Consolas"/>
                                </StackPanel>
                                <Button x:Name="BtnJoin" Grid.Column="3" Content="Join" Click="BtnJoin_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock x:Name="TxtJoinInfo" Style="{StaticResource Small}" Margin="0,8,0,0"
                                       Text="No VPN or port forwarding needed: the app finds the host and connects by itself."/>
                        </StackPanel>

                        <StackPanel x:Name="PanelPublic" Visibility="Collapsed"><TextBlock x:Name="TxtPublicInfo" Style="{StaticResource Small}" TextAlignment="Center" TextWrapping="Wrap" Text="Play on The Archstones community server."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LblPhantoms" DockPanel.Dock="Top" Text="PHANTOMS IN THIS WORLD" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,16,0,6"/>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#80050506" MinHeight="64" Padding="10,6">
                        <Grid>
                            <ItemsControl x:Name="ListPlayers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding Badge}" DockPanel.Dock="Right" Foreground="{StaticResource Soul}" FontSize="12"/>
                                            <Rectangle Width="6" Height="6" Fill="{StaticResource Soul}" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                                            </Rectangle>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource Serif}"/>
                                                <Run Text="   " />
                                                <Run Text="{Binding Area, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtNoPlayers" Style="{StaticResource Small}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Text="No one yet. Players show up here once the game goes online."/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="LblHowTo" DockPanel.Dock="Top" Text="HOW TO PLAY TOGETHER" FontFamily="{StaticResource Serif}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,14,0,4"/>
                    <TextBlock x:Name="TxtHowTo" DockPanel.Dock="Top" Style="{StaticResource Small}" LineHeight="19" Text="I. ..."/>

                    <TextBox x:Name="TxtLog" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="50"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock x:Name="TxtStatus" Text="Ready." FontSize="12.5" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="Progress" Margin="0,6,0,0" Visibility="Hidden" Maximum="1"/>
            </StackPanel>
            <Button x:Name="BtnPlay" Grid.Column="1" Content="PLAY" Style="{StaticResource PlayBtn}" Click="BtnPlay_Click"/>
            <TextBlock Grid.Column="2" Text="by mingal" FontSize="10" Foreground="{StaticResource Muted}" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
        </Grid>
    </Grid>
</Window>
