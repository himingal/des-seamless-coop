<Application x:Class="DesCoop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Demon's Souls (2020) inspired palette: near-black stone, cold bone text, tarnished gold. -->
        <FontFamily x:Key="Serif">pack://application:,,,/Fonts/#Cinzel</FontFamily>
        <SolidColorBrush x:Key="Bg" Color="#08080A"/>
        <SolidColorBrush x:Key="Panel" Color="#C00E0E11"/>
        <SolidColorBrush x:Key="Line" Color="#2E2A22"/>
        <SolidColorBrush x:Key="Text" Color="#D8D2C4"/>
        <SolidColorBrush x:Key="Muted" Color="#8C8577"/>
        <SolidColorBrush x:Key="Gold" Color="#C4A468"/>
        <SolidColorBrush x:Key="GoldDim" Color="#6E5B38"/>
        <SolidColorBrush x:Key="Soul" Color="#8FC4FF"/>
        <SolidColorBrush x:Key="Ok" Color="#9DB88A"/>
        <SolidColorBrush x:Key="Warn" Color="#D6A548"/>
        <SolidColorBrush x:Key="Bad" Color="#B5543F"/>

        <!-- A thin gold rule that fades out at both ends, like the remake's menus. -->
        <LinearGradientBrush x:Key="Rule" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00C4A468" Offset="0"/>
            <GradientStop Color="#AAC4A468" Offset="0.5"/>
            <GradientStop Color="#00C4A468" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="Backdrop" Center="0.5,0.08" GradientOrigin="0.5,0.0" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#2A2418" Offset="0"/>
            <GradientStop Color="#121014" Offset="0.45"/>
            <GradientStop Color="#060607" Offset="1"/>
        </RadialGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>

        <!-- Menu-style button: text only, a glowing gold rule appears on hover. -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent">
                            <Border x:Name="glow" Opacity="0" CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00C4A468" Offset="0"/>
                                        <GradientStop Color="#33C4A468" Offset="0.5"/>
                                        <GradientStop Color="#00C4A468" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Rule}" x:Name="rule" Opacity="0.55"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="rule" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#F3E6C6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="#EFE3C4"/>
            <Setter Property="Padding" Value="60,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#A0050506"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource GoldDim}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#A0050506"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="13" Height="13" Margin="0,1,8,0" VerticalAlignment="Top">
                                <Rectangle Stroke="{StaticResource GoldDim}" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="mark" Fill="{StaticResource Gold}" Margin="3.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Party mode selector, styled like the remake's main menu entries. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Margin="4,0">
                            <Border x:Name="glow" Opacity="0">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#40C4A468" Offset="0"/>
                                        <GradientStop Color="#00C4A468" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter Margin="12,8" HorizontalAlignment="Center"/>
                            <Border x:Name="rule" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Rule}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="rule" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#F0E3C2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="Dot" TargetType="Rectangle">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="2,7,0,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="45"/></Setter.Value></Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#1A1814"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
